# The one place for everything that makes this app ours.
# Read by scripts/prepare.sh. Shell syntax, no spaces around "=".

# Name on the home screen. "Z" tells it apart from the Matrix app during the trial.
APP_NAME="iphoneblog Z"

# Apple team and bundle id. PLACEHOLDERS until Alex's company developer account exists.
# The notification extension becomes $BUNDLE_ID.NotificationService.
TEAM_ID=TEAMID0000
BUNDLE_ID=de.iphoneblog.zulip
APP_GROUP=group.de.iphoneblog.zulip

# The only server this app talks to. The server-URL screen never shows.
SERVER_URL=https://zulip.iphoneblog.de

# Scheme of the address the server sends back after a web sign-in.
# Zulip Server hard-codes zulip://login (zerver/views/auth.py, create_response_for_otp_flow).
# The app catches it inside its own sign-in sheet (ASWebAuthenticationSession) and registers
# no URL scheme with iOS, so no other app can receive it. See README, "Sign-in".
AUTH_CALLBACK_SCHEME=zulip

# Public key of OUR push relay (Zulip's bouncer code, zilencer, on our server).
# The app encrypts its APNs token to this key instead of Zulip's.
# PLACEHOLDER (32 zero bytes) until the Zulip server session publishes the real key in the
# interfaces file. A build with the placeholder registers for push and the server rejects it.
# The TestFlight lane refuses to run while this is the placeholder.
RELAY_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Blog colour (theme-color of www.iphoneblog.de).
BRAND_COLOR=149791

# Empty: newest upstream release. Or a tag such as v30.0.275.
UPSTREAM_REF=
