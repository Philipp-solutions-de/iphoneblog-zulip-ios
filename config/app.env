# The one place for everything that makes this app ours.
# Read by scripts/prepare.sh. Shell syntax, no spaces around "=".

# Name on the home screen. "Z" tells it apart from the Matrix app during the trial.
APP_NAME="iphoneblog Z"

# Apple team and bundle id.
# Verification runs under Thorsten's own developer account with an interim bundle id
# (".preview"); at launch the final id de.iphoneblog.zulip is registered under Alex's
# company account and the testers reinstall once.
# TEAM_ID is a placeholder: CI takes the real one from the repository variable
# APPLE_TEAM_ID (environment variable of the same name when run by hand).
# The notification extension becomes $BUNDLE_ID.NotificationService.
# Push: the app sends BUNDLE_ID as its APNs app id, which is the APNs topic.
TEAM_ID=TEAMID0000
BUNDLE_ID=de.iphoneblog.zulip.preview
APP_GROUP=group.de.iphoneblog.zulip.preview

# The only server this app talks to. The server-URL screen never shows.
SERVER_URL=https://zulip.iphoneblog.de

# Scheme of the address the server sends back after a web sign-in.
# Zulip Server hard-codes zulip://login (zerver/views/auth.py, create_response_for_otp_flow).
# The app catches it inside its own sign-in sheet (ASWebAuthenticationSession) and registers
# no URL scheme with iOS, so no other app can receive it. See README, "Sign-in".
AUTH_CALLBACK_SCHEME=zulip

# Blog colour (theme-color of www.iphoneblog.de).
BRAND_COLOR=149791

# The zulip-flutter release this app is built from, and its commit. Only this pinned
# code reaches the Apple key. The weekly workflow "upstream-bump" builds a newer release
# without secrets and opens a pull request that changes these two lines.
UPSTREAM_REF=v30.0.275
UPSTREAM_COMMIT=92ebd6d86b27aaea8e7d1227c3c1f3a2082941c1
