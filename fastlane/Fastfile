# TestFlight upload. Runs only when the repository variable TESTFLIGHT_ENABLED is
# "true". docs/apple-setup.md lists what must exist first.
#
# Repository variable APPLE_TEAM_ID: the 10-character team id.
# Secrets of the environment "apple" (the same names as iphoneblog-matrix-ios):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   the App Store Connect API key
#   DIST_CERT_P12_BASE64, DIST_CERT_PASSWORD       the team's one Apple Distribution
#                                                  certificate, shared with the Matrix app Profiles come through the API
# key at build time. No certificate or profile lives in this repository.

require "base64"
require "tmpdir"
require "securerandom"

default_platform(:ios)

# Reads config/app.env (shell syntax) for BUNDLE_ID.
def app_env
  File.read(File.expand_path("../config/app.env", __dir__))
      .scan(/^([A-Z_]+)="?([^"\n]*)"?$/).to_h
end

def with_api_key
  key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
  api_key = app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
  )
  yield api_key, key_path
ensure
  File.delete(key_path) if key_path && File.exist?(key_path)
end

platform :ios do
  # Registers the app's and the notification extension's bundle ids and turns on
  # Push Notifications and App Groups, through the App Store Connect API, and sets the
  # record's name. Safe to run again: it skips what exists. The app group itself is
  # registered and tied to the ids by hand (the API has no resource for it); the
  # profiles come in the archive lane.
  lane :register_ids do
    bundle_id = app_env.fetch("BUNDLE_ID")
    name = app_env.fetch("APP_NAME")
    with_api_key do
      {
        bundle_id => ["PUSH_NOTIFICATIONS", "APP_GROUPS"],
        "#{bundle_id}.NotificationService" => ["APP_GROUPS"],
      }.each do |identifier, capabilities|
        bid = Spaceship::ConnectAPI::BundleId.find(identifier)
        if bid
          UI.message("#{identifier}: exists")
        else
          bid = Spaceship::ConnectAPI::BundleId.create(
            name: "#{name} #{identifier.end_with?('NotificationService') ? 'Notifications' : 'App'}".gsub(/[^A-Za-z0-9 ]/, ""),
            platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
            identifier: identifier,
          )
          UI.success("#{identifier}: registered")
        end
        have = bid.get_capabilities.map(&:capability_type)
        capabilities.each do |cap|
          if have.include?(cap)
            UI.message("#{identifier}: #{cap} already on")
          else
            bid.create_capability(cap)
            UI.success("#{identifier}: #{cap} turned on")
          end
        end
      end
    end

    # The App Store Connect record's name, from APP_STORE_NAME. Apple lets the name change
    # until the first release; it must be unique in the App Store.
    store_name = app_env.fetch("APP_STORE_NAME")
    with_api_key do
      app = Spaceship::ConnectAPI::App.find(bundle_id)
      if app.nil?
        UI.important("no app record for #{bundle_id} yet; create it by hand (docs/apple-setup.md)")
        next
      end
      info = app.fetch_edit_app_info || app.fetch_live_app_info
      info.get_app_info_localizations.each do |loc|
        if loc.name == store_name
          UI.message("record name (#{loc.locale}): #{loc.name}")
        else
          loc.update(attributes: { name: store_name })
          UI.success("record name (#{loc.locale}): #{loc.name} -> #{store_name}")
        end
      end
    end
  end

  # Builds, signs and exports the App Store .ipa from the prepared upstream/ checkout.
  # Signing is manual, as in the Matrix app: the team's one Apple Distribution
  # certificate comes from the environment secrets DIST_CERT_P12_BASE64 and
  # DIST_CERT_PASSWORD into a throwaway keychain, and sigh fetches (or creates) the App
  # Store profiles through the API key. No xcodebuild login, no device, no Apple ID.
  # Only the two app targets are touched; Flutter's and the pods' targets keep theirs.
  private_lane :archive do |options|
    api_key = options.fetch(:api_key)
    team_id = ENV.fetch("APPLE_TEAM_ID", "")
    UI.user_error!("repository variable APPLE_TEAM_ID is not set") unless team_id.match?(/\A[A-Z0-9]{10}\z/)
    bundle_id = app_env.fetch("BUNDLE_ID")
    ios = File.expand_path("../upstream/ios", __dir__)

    keychain = File.join(Dir.tmpdir, "iphoneblog-signing.keychain-db")
    keychain_password = SecureRandom.hex(24)
    create_keychain(path: keychain, password: keychain_password, default_keychain: false,
                    unlock: true, timeout: 3600, lock_when_sleeps: false, add_to_search_list: true)
    p12 = File.join(Dir.tmpdir, "distribution.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("DIST_CERT_P12_BASE64")))
    File.chmod(0o600, p12)
    begin
      import_certificate(certificate_path: p12, certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
                         keychain_path: keychain, keychain_password: keychain_password, log_output: false)
    ensure
      File.delete(p12) if File.exist?(p12)
    end

    # App Store builds talk to Apple's production push service.
    sh("/usr/libexec/PlistBuddy", "-c", "Set :aps-environment production",
       File.join(ios, "Runner/Runner.entitlements"))

    profiles = {}
    { "Runner" => bundle_id, "NotificationService" => "#{bundle_id}.NotificationService" }.each do |target, identifier|
      get_provisioning_profile(api_key: api_key, app_identifier: identifier, team_id: team_id,
                               output_path: File.expand_path("../build/profiles", __dir__))
      name = lane_context[SharedValues::SIGH_NAME]
      profiles[identifier] = name
      update_code_signing_settings(path: File.join(ios, "Runner.xcodeproj"), targets: [target],
                                   use_automatic_signing: false, team_id: team_id,
                                   code_sign_identity: "Apple Distribution",
                                   profile_name: name, bundle_identifier: identifier)
    end

    build_app(
      workspace: File.join(ios, "Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      output_directory: File.expand_path("../build/ipa", __dir__),
      xcargs: "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain}'",
      export_team_id: team_id,
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: profiles,
      },
    )
  end

  desc "Build, sign and export for the App Store without uploading (Signing check)"
  lane :signed_build do
    with_api_key { |api_key, _| archive(api_key: api_key) }
  end

  desc "Build, sign and upload to TestFlight"
  lane :testflight_upload do
    with_api_key do |api_key, _|
      archive(api_key: api_key)
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        changelog: "Build #{ENV.fetch('BUILD_NUMBER', '?')} from #{ENV.fetch('GITHUB_SHA', 'local')[0, 7]}.",
      )
    end
  end
end
