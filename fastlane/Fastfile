# TestFlight upload. Off until Alex's company developer account exists:
# the workflow runs this lane only when the repository variable
# TESTFLIGHT_ENABLED is "true". See README, "TestFlight".
#
# Needs three repository secrets from an App Store Connect API key
# (role App Manager): ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (the .p8 text).
# Signing is Xcode's cloud-managed signing, authorised by the same key:
# no certificates or profiles live in this repository.

default_platform(:ios)

platform :ios do
  lane :testflight_upload do
    env = File.read(File.expand_path("../config/app.env", __dir__))
    UI.user_error!("RELAY_PUBLIC_KEY in config/app.env is still the placeholder") if env.include?("RELAY_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
    UI.user_error!("TEAM_ID in config/app.env is still the placeholder") if env.include?("TEAM_ID=TEAMID0000")
    key_path = File.expand_path("asc_key.p8", __dir__)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
    )

    build_app(
      workspace: "upstream/ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" "),
      export_xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
